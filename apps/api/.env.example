# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/vintrix

# AES-256-GCM master key for credential encryption (min 32 chars in production)
ENCRYPTION_MASTER_KEY=change-me-to-a-secure-random-32-char-key!!

# JWT secret for auth tokens
JWT_SECRET=change-me-to-a-secure-random-secret

# API port
PORT=3001

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

