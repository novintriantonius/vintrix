{
  "name": "vintrix-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter \"@vintrix/*\" dev",
    "build": "bun --filter \"@vintrix/*\" build",
    "lint": "bun --filter \"@vintrix/*\" lint",
    "test": "bun test --coverage",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/dist packages/*/node_modules packages/*/dist"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
